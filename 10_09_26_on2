import pandas as pd
df = pd.read_csv("games.csv")

# Crear las columnas de diferencias y total de puntos
df["TOTAL_POINTS"] = df["PTS_home"] + df["PTS_away"]
df["DIFF_POINTS"] = (df["PTS_home"] - df["PTS_away"]).abs()

# Tomamos una muestra de 1000 registros para que Bubble Sort
sample = df.head(1000).to_dict("records")

def bubble_sort(arr, key):
    n = len(arr)
    for i in range(n):
        for j in range(0, n - i - 1):
            if arr[j][key] < arr[j + 1][key]:  # Orden descendente
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
    return arr


# Ejecutar Bubble Sort por diferencia de puntos
sorted_games = bubble_sort(sample, "DIFF_POINTS")

# Mostrar las 10 mayores palizas
print(" TOP 10 PALIZAS HISTÓRICAS (Bubble Sort O(n^2)) ")
for g in sorted_games[:10]:
    print(
        f"Fecha: {g['GAME_DATE_EST']} | Diferencia: {g['DIFF_POINTS']} pts ({g['PTS_home']} - {g['PTS_away']})"
    )