import os
import pandas as pd

# 1. Ruta exacta hacia tu carpeta de Descargas
ruta_csv = os.path.expanduser("~/Downloads/games.csv")

# 2. Cargar los datos desde el archivo
df = pd.read_csv(ruta_csv)

# 3. Preparar los datos
# Convertimos el DataFrame a una lista de diccionarios para poder usar el código de la diapositiva
df["TOTAL_POINTS"] = df["PTS_home"] + df["PTS_away"]
df["DIFF_POINTS"] = (df["PTS_home"] - df["PTS_away"]).abs()

# Para que no tarde demasiado con los 50.000 registros en O(n^2), tomamos una muestra
sample = df.head(1000).to_dict("records")


# 4. Función Bubble Sort O(n^2) mostrada en la pantalla
def bubble_sort(arr, key):
    n = len(arr)
    for i in range(n):
        for j in range(0, n - i - 1):
            if arr[j][key] < arr[j + 1][key]:  # Orden descendente
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
    return arr


# 5. Ejecutar Bubble Sort por diferencia de puntos (palizas)
sorted_games = bubble_sort(sample, "DIFF_POINTS")

# 6. Mostrar el top 10 de palizas
print("--- TOP 10 PALIZAS HISTÓRICAS (Bubble Sort) ---")
for g in sorted_games[:10]:
    print(
        f"{g['GAME_DATE_EST']}: Diferencia {g['DIFF_POINTS']} pts ({g['PTS_home']} - {g['PTS_away']})"
    )